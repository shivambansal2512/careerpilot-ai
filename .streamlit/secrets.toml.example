# Copy to .streamlit/secrets.toml (git-ignored) and fill in at least one LLM key.
# On Streamlit Community Cloud, paste the same lines under App settings -> Secrets.

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY = ""

# Groq (free): https://console.groq.com/keys
# GROQ_API_KEY = ""

# Optional: pick the provider / model explicitly (defaults: gemini, first model in llm.py)
# LLM_PROVIDER = "gemini"
# LLM_MODEL = "gemini-2.5-flash"

# Optional: live job postings from Adzuna (https://developer.adzuna.com/)
# ADZUNA_APP_ID = ""
# ADZUNA_APP_KEY = ""
